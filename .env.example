# Contoh konfigurasi environment Usaha Qita — powered by BRI
# Salin file ini menjadi .env.local untuk pengaturan lokal di komputer Anda:
# cp .env.example .env.local

# CATATAN KEAMANAN:
# Jangan pernah menaruh API Key sungguhan di file ini (.env.example).
# File .env.local sudah masuk dalam .gitignore dan tidak akan terunggah ke Git.

# Gemini API Key (Akan digunakan pada fase AI terpisah di sisi server saja)
# GEMINI_API_KEY=masukkan_api_key_disini_tanpa_awalan_NEXT_PUBLIC
\n# MySQL Database connection (Untuk Navicat & Prisma)\nDATABASE_URL="mysql://root:@localhost:3306/usaha_qita"\n