# ==============================================================================
# UsahaQita - Konfigurasi Lingkungan Produksi (VPS Docker)
# ==============================================================================
# 1. URL Koneksi Basis Data MySQL (Jaringan Internal Docker Compose)
DATABASE_URL="mysql://usahaqita:usahaqita_secret_password@db:3306/usaha_qita"

# 2. Kata Sandi Root & User MySQL Kontainer
MYSQL_ROOT_PASSWORD="usahaqita_root_secret"
MYSQL_USER="usahaqita"
MYSQL_PASSWORD="usahaqita_secret_password"
MYSQL_DATABASE="usaha_qita"

# 3. Kunci API Google Gemini (Wajib untuk Analisis Sentra & Rekomendasi Usaha)
GEMINI_API_KEY="MASUKKAN_KUNCI_API_GEMINI_ANDA_DI_SINI"

# 4. Pengaturan Node.js
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
